<!doctype html>
<html lang="fr" data-fr-scheme="system" dir="ltr">
<head>
  <meta charset="utf-8">
  <meta name="format-detection" content="telephone=no,date=no,address=no,email=no,url=no">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

  <meta name="description" content="{{ description or metadata.description }}">
  <meta name="theme-color" content="#000091">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png"><!-- 180×180 -->
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon"><!-- 32×32 -->
  <link rel="manifest" href="/manifest.webmanifest" crossorigin="use-credentials">

  {#- Atom and JSON feeds included by default #}
  <link rel="alternate" href="/feed/feed.xml" type="application/atom+xml" title="{{ metadata.title }}">
  <link rel="alternate" href="/feed/feed.json" type="application/json" title="{{ metadata.title }}">

  <link rel="stylesheet" href="/css/dsfr.min.css">
  <link rel="stylesheet" href="/css/utility/utility.min.css">

  {%- css %}{% include "public/css/index.css" %}{% endcss %}
  {%- css %}{% include "public/css/decouvrir.css" %}{% endcss %}
  {%- css %}{% include "public/css/services.css" %}{% endcss %}
  {%- css %}{% include "public/css/page_usage.css" %}{% endcss %}
  {%- css %}{% include "public/css/prism-diff.css" %}{% endcss %}
  {%- css %}{% include "node_modules/prismjs/themes/prism-okaidia.css" %}{% endcss %}
  {# {%- css %}{% include "node_modules/dsfr-extension/dist/icons.css" %}{% endcss %} #}
  {%- css %}{% include "public/icons/icons.css" %}{% endcss %}

  <style>{% getBundle "css" %}</style>

  <meta name="generator" content="{{ eleventy.generator }}">
  {% if noindex %}
  <meta name="robots" content="noindex">
  {% endif %}

  {# Configuration de l'API JS DSFR (avant chargement des modules) #}
<script>
    window.dsfr = {
        mode: 'auto',
        production: {{ metadata.analytics.site.environment == "production" }},
        analytics: {
            domain: '{{ metadata.analytics.domain }}',
            collection: 'auto',
            isActionEnabled: true,
            page: {
                template: 'article'
            },
            site: {
                entity: '{{ metadata.analytics.site.entity }}',
                environment: '{{ metadata.analytics.site.environment | default("production") }}'
            }
        }
    };
</script>

<!-- Matomo -->
  <script>
    var _paq = window._paq = window._paq || [];
    // _paq.push(["setDocumentTitle", "[Explorer]" + document.title]);
    _paq.push(["setDoNotTrack", true]);
    _paq.push(['trackPageView']);
    _paq.push(['enableLinkTracking']);
    (function() {
        var u="https://matomo.ign.fr/";
        _paq.push(['setTrackerUrl', u+'matomo.php']);
      _paq.push(['setSiteId', '11']);
        var d=document, g=d.createElement('script'), s=d.getElementsByTagName('script')[0];
        g.async=true; g.src=u+'matomo.js'; s.parentNode.insertBefore(g,s);
    })();
  </script>
<!-- End Matomo Code -->

<!-- Matomo Functions -->
  <script>
    // Désactivation du suivi
    function disableMatomoTracking() {
      var _paq = window._paq = window._paq || [];
      // 13 mois ≈ 396 jours (durée recommandée par la CNIL) = 396 × 24 = 9504 heures
      _paq.push(['optUserOut', 9504]);
    }

    // Réactivation du suivi
    function enableMatomoTracking() {
      var _paq = window._paq = window._paq || [];
      _paq.push(['forgetUserOptOut']);
    }
  </script>
<!-- End Matomo Functions -->

  <script type="module" src="/js/header-auth.js"></script>
  <script src="/js/header-logo.js" defer></script>
  <script src="/js/env.js"></script>

  <title>{{ title  ~ " | " ~ metadata.title }}</title>
</head>
<body id="top">
{% getBundle "js", "top" %}

{% include "templates/header.njk" %}

<main id="content" role="main">
  {{ content | safe }}
  {% if hideNewsletterBanner != true %}
    {% include "templates/newsletter.njk" %}
  {% endif %}
</main>


{% include "templates/footer.njk" %}

{% include "templates/display.njk" %}

<!-- Current page: {{ page.url | htmlBaseUrl }} -->

{% js "top" %}
  <script>
      // Fix FOUC in dark mode
      setDarkBeforeRender = () => {
          const localScheme = localStorage.getItem('scheme')
          if (localScheme === 'dark' || (localScheme === 'system' && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
              document.documentElement.setAttribute('data-fr-theme', 'dark');
          }
      }
      setDarkBeforeRender();
  </script>
{% endjs %}
{% js "body" %}
  <script>
      const SEARCH_RESULTS_URL = "{{ "/search-results/" | htmlBaseUrl }}";
  </script>
  {# <script type="text/javascript" src="/js/search.js"></script> #}
{% endjs %}
{% getBundle "js", "body" %}
<!-- Script en version es6 module et nomodule pour les navigateurs le ne supportant pas -->
<script type="module" src="/js/dsfr.module.min.js"></script>
<script type="module" src="/js/analytics.module.min.js"></script>
<script type="text/javascript" nomodule src="/js/dsfr.nomodule.min.js"></script>
<script type="text/javascript" nomodule src="/js/analytics.nomodule.min.js"></script>
<script type="text/javascript" src="/js/consent-manager.js"></script>
</body>
</html>
